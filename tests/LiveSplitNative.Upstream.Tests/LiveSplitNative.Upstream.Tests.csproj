<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Differential tests: upstream LiveSplit.Core source (Upstream/, pinned, MIT) compiled next
    to LiveSplitNative.Core, both driven by the same commands on the same manual clock.
    Upstream files keep their own explicit usings and non-nullable style, so implicit usings
    and nullable warnings are off for this project only. The .lss corpus tests also run
    upstream's StandardFormatsRunFactory over livesplit-core's C API (LiveSplitCore.g.cs).
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>LiveSplitNative.Upstream.Tests</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS0618;CS0649;CS0169;CS8632;CS1998</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\LiveSplitNative.Core\LiveSplitNative.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Real .lss files for the generator differential tests (loaded with our parser, copied to upstream). -->
    <None Include="..\fixtures\*.lss" Link="fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The .lss corpus (Basten's splits, livesplit-core's test files) for the corpus tests. -->
    <None Include="..\fixtures\corpus\*.lss" Link="fixtures\corpus\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- livesplit-core's C API, the parser Windows LiveSplit opens splits with (native/README.md), when it was built. -->
  <ItemGroup Condition="Exists('..\..\native\osx-arm64\liblivesplit_core.dylib')">
    <None Include="..\..\native\osx-arm64\liblivesplit_core.dylib" Link="liblivesplit_core.dylib" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
