<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:LiveSplitNative.App"
        x:Class="LiveSplitNative.App.ChooseComparisonsWindow"
        Title="Choose Comparisons"
        Width="360"
        MinWidth="340"
        MaxWidth="520"
        MinHeight="230"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        FontSize="12"
        FontFamily="SF Pro Text, Segoe UI, fonts:Inter#Inter, sans-serif"
        local:SettingsLayout.LabelWidth="170">
  <!--
    Port of LiveSplit.View ChooseComparisonsDialog: one checkbox per standard generator, in
    Windows order, and a "Golf HCP Settings" group that is only shown while Golf HCP is checked.
  -->
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="dialogFooter">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button Classes="dialog" Content="Cancel" IsCancel="True" Click="OnCancel"/>
        <Button Classes="dialog primary" Content="OK" IsDefault="True" Click="OnOk"/>
      </StackPanel>
    </Border>

    <StackPanel Margin="24,20" Spacing="22">
      <local:SettingsCard x:Name="ComparisonsList"/>
      <local:SettingsSection x:Name="HcpGroup" Header="Golf HCP Settings">
        <local:SettingsCard x:Name="HcpGrid"/>
      </local:SettingsSection>
    </StackPanel>
  </DockPanel>
</Window>
