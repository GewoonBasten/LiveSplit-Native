<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LiveSplitNative.App.LayoutEditorWindow"
        Title="Layout Editor"
        Width="520"
        MinWidth="420" MinHeight="260"
        MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        SizeToContent="Height"
        FontSize="12"
        FontFamily="SF Pro Text, Segoe UI, fonts:Inter#Inter, sans-serif">
  <!--
    Content-aware height (SizeToContent=Height): short list → compact window;
    many components → list scrolls (MaxHeight). Bottom OK row always docked visible.
    No decorative component-type icons in the list — names + subtle separators only.
  -->
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="dialogFooter">
    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
      <Button Classes="dialog" Content="Layout Settings..." Click="OnLayoutSettings" Margin="0,0,8,0"/>
      <!-- LayoutEditorDialog: Horizontal, then Vertical, right next to OK; 6 px apart on Windows,
           8 here like OK and Cancel. -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,16,0">
        <RadioButton x:Name="HorizontalRadio" Content="Horizontal" GroupName="Mode"/>
        <RadioButton x:Name="VerticalRadio" Content="Vertical" GroupName="Mode" IsChecked="True"/>
      </StackPanel>
      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10">
        <Button Classes="dialog" Content="Cancel" IsCancel="True" Click="OnCancel"/>
        <Button Classes="dialog primary" Content="OK" IsDefault="True" Click="OnOk"/>
      </StackPanel>
    </Grid>
    </Border>

    <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Top" Margin="18,20,24,20">
      <!-- Windows Layout Editor: circular + − ↑ ↓ with breathing room (~41px row pitch). The
           symbols are drawn (12×12, centred), not font glyphs: arrow glyphs sit off-centre. -->
      <StackPanel x:Name="ToolbarPanel" Spacing="10" Margin="6,4,12,0" Width="44" HorizontalAlignment="Center"
                  VerticalAlignment="Top">
        <Button x:Name="BtnAdd" Classes="layoutTool" Click="OnAdd"
                ToolTip.Tip="Add Component">
          <Path Data="M6,1.5 L6,10.5 M1.5,6 L10.5,6" Width="12" Height="12" Stretch="None" StrokeThickness="1.6"
                StrokeLineCap="Round" StrokeJoin="Round"
                Stroke="{Binding $parent[Button].Foreground}"/>
        </Button>
        <Button Classes="layoutTool" Click="OnRemove"
                ToolTip.Tip="Remove">
          <Path Data="M1.5,6 L10.5,6" Width="12" Height="12" Stretch="None" StrokeThickness="1.6"
                StrokeLineCap="Round" StrokeJoin="Round"
                Stroke="{Binding $parent[Button].Foreground}"/>
        </Button>
        <Button Classes="layoutTool" Click="OnMoveUp"
                ToolTip.Tip="Move Up">
          <Path Data="M6,10.5 L6,1.5 M2,5.5 L6,1.5 L10,5.5" Width="12" Height="12" Stretch="None" StrokeThickness="1.6"
                StrokeLineCap="Round" StrokeJoin="Round"
                Stroke="{Binding $parent[Button].Foreground}"/>
        </Button>
        <Button Classes="layoutTool" Click="OnMoveDown"
                ToolTip.Tip="Move Down">
          <Path Data="M6,1.5 L6,10.5 M2,6.5 L6,10.5 L10,6.5" Width="12" Height="12" Stretch="None" StrokeThickness="1.6"
                StrokeLineCap="Round" StrokeJoin="Round"
                Stroke="{Binding $parent[Button].Foreground}"/>
        </Button>
      </StackPanel>
      <Border Grid.Column="1"
              VerticalAlignment="Top"
              BorderBrush="{DynamicResource LsDialogCardBorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Background="{DynamicResource LsDialogCardBackground}"
              ClipToBounds="True">
        <ListBox x:Name="ComponentsList"
                 Background="Transparent"
                 BorderThickness="0"
                 MinHeight="84"
                 MaxHeight="420"
                 VerticalAlignment="Top"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 DoubleTapped="OnComponentDoubleTapped"
                 ItemContainerTheme="{StaticResource LayoutEditorListBoxItemTheme}"/>
      </Border>
    </Grid>
  </DockPanel>
</Window>
